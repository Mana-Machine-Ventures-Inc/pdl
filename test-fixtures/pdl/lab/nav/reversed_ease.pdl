// Token-only: `.reversed` time-reverses Ease (pair clock + Motion slot clocks).

semantic motion.slideOut: PresentationMotion = PresentationMotion(
  incoming: Pose(translateX: 390),
  outgoing: Pose(translateX: -48),
  duration: 320,
  ease: .out,
  delay: 40,
  front: .incoming
)
semantic motion.slideIn: PresentationMotion = motion.slideOut.reversed

semantic motion.material: PresentationMotion = PresentationMotion(
  incoming: Pose(translateX: 390),
  outgoing: Pose(opacity: 0),
  duration: 400,
  ease: Ease.bezier(0.2, 0, 0, 1)
)
semantic motion.materialBack: PresentationMotion = motion.material.reversed

semantic motion.slotClocks: PresentationMotion = PresentationMotion(
  incoming: Animation(
    keys: [Motion(duration: 200, ease: .out, pose: Pose(translateX: 40))]
  ),
  outgoing: Animation(
    keys: [Motion(duration: 200, ease: .in, pose: Pose(opacity: 0))]
  ),
  front: .outgoing
)
semantic motion.slotClocksBack: PresentationMotion = motion.slotClocks.reversed

semantic motion.holdLinear: PresentationMotion = PresentationMotion(
  incoming: Pose(opacity: 0),
  outgoing: Pose(opacity: 0),
  duration: 100,
  ease: .linear
)
semantic motion.holdLinearBack: PresentationMotion = motion.holdLinear.reversed

semantic motion.cardSwap: PresentationMotion = PresentationMotion(
  incoming: Pose(translateX: -36),
  outgoing: Pose(translateX: 36),
  duration: 480,
  front: .outgoing,
  switchAt: 144
)
semantic motion.cardSwapBack: PresentationMotion = motion.cardSwap.reversed

semantic motion.cardToss: PresentationMotion = PresentationMotion(
  incoming: Animation(
    start: Pose(translateX: 390, opacity: 0),
    keys: [
      Motion(duration: 264, ease: .out, pose: Pose(translateX: 40)),
      Motion(duration: 216, ease: .out, pose: .rest)
    ]
  ),
  outgoing: Pose(translateX: -48, opacity: 0.86),
  duration: 320,
  ease: .in,
  front: .outgoing,
  switchAt: 144
)
semantic motion.cardTossBack: PresentationMotion = motion.cardToss.reversed
