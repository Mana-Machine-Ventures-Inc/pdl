  description = "Pose.blur in CSS px (filter). Appear unblurs 16 → sharp without fading."
}

component MotionPoseLab() layout {
  direction = .column
  gap = 16
  padding = 20
  background = #F9FAFB
  width = .fill

  let opacity = MotionPoseOpacity()
  let scale = MotionPoseScale()
  let scaleX = MotionPoseScaleX()
  let scaleY = MotionPoseScaleY()
  let translateX = MotionPoseTranslateX()
  let translateY = MotionPoseTranslateY()
  let blur = MotionPoseBlur()
  children = [opacity, scale, scaleX, scaleY, translateX, translateY, blur]
}

usage MotionPoseLab {
  description = "One card per Pose field. Appear / Dismiss / Reset isolate that channel."
}

component MotionLab() layout {
  direction = .column
  gap = 20
  padding = 20
  background = #F9FAFB
  width = .fill

  let modal = MotionModal()
  let list = MotionStaggerList()
  let blur = MotionBlurCard()
  let chip = MotionHoverChip()
  children = [modal, list, blur, chip]
}

usage MotionLab {
  description = "Motion walkthrough. Play each clip on the rack (modal, list, blur, chip). Hover the chip for implicit interpolation."
}
