component MotionPoseLab() layout {
  direction = .column
  gap = 16
  padding = 20
  background = #F9FAFB
  width = .fill

  let opacity = MotionPoseOpacity()
  let scale = MotionPoseScale()
  let scaleX = MotionPoseScaleX()
  let scaleY = MotionPoseScaleY()
  let translateX = MotionPoseTranslateX()
  let translateY = MotionPoseTranslateY()
  let blur = MotionPoseBlur()
  let rotate = MotionPoseRotate()
  children = [opacity, scale, scaleX, scaleY, translateX, translateY, blur, rotate]
}

usage MotionPoseLab {
  description = "One card per Pose field. Appear / Dismiss / Reset isolate that channel."
}

component PressPopButton <PointerInput>(
  label: String = "Press me",
  chrome: PressPopState = .rest
) layout {
  direction = .row
  align = .center
  justify = .center
  padding = EdgeInsets(x: 22, y: 12)
  width = .hug
  cornerRadius = 14
  background = #E8EEF4
  shadow = Shadow(x: 4, y: 6, blurRadius: 14, color: #1E293B @ 0.2)

  if chrome == .pressed {
    background = #C5CED8
    shadow = Shadow(x: 1, y: 1, blurRadius: 3, color: #1E293B @ 0.12)
  }

  let text = Text(content: label, color: #334155, fontSize: 15, fontWeight: 600)
  children = [text]

  self.pressStart = {
    animate = motion.pressIn
    chrome = .pressed
  }
  self.pressEnd = {
    animate = motion.pressPop
    chrome = .rest
  }
  self.pressCancel = {
    animate = Animation(
      keys: [Motion(duration: 90, ease: .out, pose: .rest)]
    )
    chrome = .rest
  }
}

usage PressPopButton {
  description = "Press holds a shrink. Release plays an overshoot then .rest. Cancel authors return to .rest."
}

component PressPopLab() layout {
  direction = .column
  align = .center
  justify = .center
  gap = 16
  padding = 40
  width = .fill
  background = #D5DCE6

  let button = PressPopButton()
  let hint = Text(content: "Press, hold, release. Clip rack: Press start / Press end.", color: #64748B, fontSize: 13)
  children = [button, hint]
}

usage PressPopLab {
  description = "Soft stage so the raised / pressed shadows read. Default for the press-pop stub."
}

/// Two concurrent Animations from one pressEnd — box scales fast, label fades slow.
component MotionTargetedDemo <PointerInput>() layout {
  direction = .column
  align = .center
  gap = 12
  padding = 16
  width = 220
  background = #FFFFFF
  cornerRadius = 12
  borderWidth = 1
  borderColor = #E5E7EB

  let box = Layout(
    width: 120,
    height: 72,
    background: #3B82F6,
    cornerRadius: 10
  )
  let label = Text(content: "Press me", color: #111827, fontSize: 14, fontWeight: 600)
  children = [box, label]

  self.pressStart = {
    box.animate = Animation(
      keys: [Motion(duration: 120, ease: .in, pose: Pose(scale: 0.94))]
    )
    label.animate = Animation(
      keys: [Motion(duration: 120, ease: .in, pose: Pose(opacity: 0.55))]
    )
  }
  self.pressEnd = {
    box.animate = Animation(
      keys: [
        Motion(duration: 210, ease: .out, pose: Pose(scale: 1.08)),
        Motion(duration: 210, ease: .out, pose: .rest)
      ]
    )
    label.animate = Animation(
      keys: [
        Motion(duration: 450, ease: .out, pose: Pose(opacity: 0.55)),
        Motion(duration: 450, ease: .out, pose: .rest)
      ]
    )
  }
  self.pressCancel = {
    box.animate = Animation(
      keys: [Motion(duration: 200, ease: .out, pose: .rest)]
    )
    label.animate = Animation(
      keys: [Motion(duration: 200, ease: .out, pose: .rest)]
    )
  }
}

component MotionLab() layout {
  direction = .column
  gap = 20
  padding = 20
  background = #F9FAFB
  width = .fill

  let modal = MotionModal()
  let list = MotionStaggerList()
  let blur = MotionBlurCard()
  let chip = MotionHoverChip()
  let flourish = MotionHoverFlourish()
  let pop = MotionHoverPop()
  let overridePop = MotionHoverPopOverride()
  let spin = MotionStandingSpin()
  let spinSelf = MotionStandingSelf()
  let pulse = MotionPulse()
  let sheen = MotionSheen()
  let appearPulse = MotionAppearThenPulse()
  let pressPop = PressPopButton()
  let targeted = MotionTargetedDemo()
  children = [modal, list, blur, chip, flourish, pop, overridePop, spin, spinSelf, pulse, sheen, appearPulse, pressPop, targeted]
}

usage MotionLab {
  description = "Motion walkthrough. Play each clip on the rack. Hover the chip (state) or the pop tokens (pose track)."
}
