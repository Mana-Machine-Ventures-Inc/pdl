component MotionPoseRotate <PointerInput>() layout {
  direction = .column
  gap = 6
  padding = 20
  width = 280
  background = #FFFFFF
  cornerRadius = 12
  borderWidth = 1
  borderColor = #E5E7EB

  let title = Text(content: "rotate", color: #111827, fontSize: 16, fontWeight: 600)
  let body = Text(content: "−12° → 0. Tilt in around center.", color: #6B7280, fontSize: 13)
  children = [title, body]

  self.appear = {
    animate = Motion(
      transition: (duration: 400, easing: "ease-out"),
      pose: Pose(rotate: -12)
    )
  }
  self.dismiss = {
    animate = Motion(
      transition: (duration: 280, easing: "ease-in"),
      pose: Pose(rotate: -12)
    )
  }
}

usage MotionPoseRotate {
  description = "Pose.rotate in degrees. Appear untilts −12 → 0. originX / originY (0…1) set the pivot."
}

component MotionPoseLab() layout {
  direction = .column
  gap = 16
  padding = 20
  background = #F9FAFB
  width = .fill

  let opacity = MotionPoseOpacity()
  let scale = MotionPoseScale()
  let scaleX = MotionPoseScaleX()
  let scaleY = MotionPoseScaleY()
  let translateX = MotionPoseTranslateX()
  let translateY = MotionPoseTranslateY()
  let blur = MotionPoseBlur()
  let rotate = MotionPoseRotate()
  children = [opacity, scale, scaleX, scaleY, translateX, translateY, blur, rotate]
}

usage MotionPoseLab {
  description = "One card per Pose field. Appear / Dismiss / Reset isolate that channel."
}

component MotionLab() layout {
  direction = .column
  gap = 20
  padding = 20
  background = #F9FAFB
  width = .fill

  let modal = MotionModal()
  let list = MotionStaggerList()
  let blur = MotionBlurCard()
  let chip = MotionHoverChip()
  let flourish = MotionHoverFlourish()
  let pop = MotionHoverPop()
  let overridePop = MotionHoverPopOverride()
  let spin = MotionStandingSpin()
  let spinSelf = MotionStandingSelf()
  let pulse = MotionPulse()
  let sheen = MotionSheen()
  let appearPulse = MotionAppearThenPulse()
  children = [modal, list, blur, chip, flourish, pop, overridePop, spin, spinSelf, pulse, sheen, appearPulse]
}

usage MotionLab {
  description = "Motion walkthrough. Play each clip on the rack. Hover the chip (tree tween) or the pop tokens (pose track)."
}
