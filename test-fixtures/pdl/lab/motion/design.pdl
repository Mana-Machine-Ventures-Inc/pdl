// Playground lab — HTML preview motion (WAAPI overlay + Replay).
// Bake stays at rest pose. Hex colors and inline Timing / Ease — no import.

variant InteractionState {
  case rest
  case hovered
}

semantic motion.hoverPop: Animation = Animation(
  keys: [
    Motion(duration: 112, ease: .out, pose: Pose(scale: 1.12)),
    Motion(duration: 168, ease: .out, pose: Pose(scale: 1.04))
  ]
)

semantic motion.hoverPopHeld: Animation = Animation(
  keys: [
    Motion(duration: 280, ease: .out, pose: Pose(scale: 1.12))
  ]
)

semantic motion.spin: Animation = Animation(
  keys: [
    Motion(duration: 800, ease: .linear, pose: Pose(rotate: 360))
  ],
  repeat: .forever
)

semantic motion.pulse: Animation = Animation(
  keys: [
    Motion(duration: 450, ease: Ease.bezier(0.42, 0, 0.58, 1), pose: Pose(opacity: 0.45, scale: 0.96)),
    Motion(duration: 450, ease: Ease.bezier(0.42, 0, 0.58, 1), pose: .rest)
  ],
  repeat: .forever
)

semantic motion.sheen: Animation = Animation(
  start: Pose(translateX: -80),
  keys: [
    Motion(duration: 1400, ease: .linear, pose: Pose(translateX: 160))
  ],
  repeat: .forever
)

variant PressPopState {
  case rest
  case pressed
}

semantic motion.pressIn: Animation = Animation(
  keys: [
    Motion(duration: 90, ease: .in, pose: Pose(scale: 0.94, translateY: 1))
  ]
)

semantic motion.pressPop: Animation = Animation(
  keys: [
    Motion(duration: 147, ease: .out, pose: Pose(scale: 1.08, translateY: -3)),
    Motion(duration: 126, ease: .out, pose: Pose(scale: 0.98)),
    Motion(duration: 147, ease: .out, pose: .rest)
  ]
)

component MotionModal <PointerInput>() layout {
  direction = .column
  gap = 8
  padding = 20
  width = 280
  background = #FFFFFF
  cornerRadius = 12
  borderWidth = 1
  borderColor = #E5E7EB

  let title = Text(content: "Save playlist?", color: #111827, fontSize: 16, fontWeight: 600)
  let body = Text(content: "This card plays appear / dismiss. Use Appear and Dismiss.", color: #6B7280, fontSize: 13)
  children = [title, body]

  self.appear = {
    animate = Animation(
      start: Pose(opacity: 0, scale: 0.95, translateY: 8),
      keys: [Motion(duration: 250, ease: .out, pose: .rest)]
    )
  }
  self.dismiss = {
    animate = Animation(
      keys: [
        Motion(duration: 180, ease: .in, pose: Pose(opacity: 0, scale: 0.95, translateY: 8))
      ]
    )
  }
}

usage MotionModal {
  description = "Modal-shaped card. Appear fades and scales in from 8px below. Use Appear / Dismiss on the clip rack."
}

component MotionStaggerRow(label: String = "Item") layout {
  direction = .row
  padding = EdgeInsets(x: 12, y: 8)
  background = #F3F4F6
  cornerRadius = 6
  width = .fill
  let text = Text(content: label, color: #111827, fontSize: 13)
  children = [text]
}

component MotionStaggerList <PointerInput>() layout {
  direction = .column
  gap = 8
  padding = 16
  width = 280
  background = #FFFFFF
  cornerRadius = 12

  let a = MotionStaggerRow(label: "First")
  let b = MotionStaggerRow(label: "Second")
  let c = MotionStaggerRow(label: "Third")
  children = [a, b, c]

  self.appear = {
    animate = Animation(
      start: Pose(blur: 18, opacity: 0, translateY: 10),
      keys: [Motion(duration: 220, ease: .out, pose: .rest)],
      stagger: Stagger(step: 40, from: .last)
    )
  }
}

usage MotionStaggerList {
  description = "Direct children stagger in 40ms steps from the last row."
}

component MotionHoverChip <PointerInput>(
  label: String = "Hover me",
  interactionState: InteractionState = .rest
) layout {
  direction = .row
  align = .center
  justify = .center
  padding = EdgeInsets(x: 14, y: 8)
  cornerRadius = 999
  width = .hug
  background = #2563EB

  if interactionState == .hovered {
    background = #000000
  }
  
  let text = Text(content: label, color: #FFFFFF, fontSize: 13, fontWeight: 600)
  children = [text]

  hoverStart = {
    interactionState = .hovered
  }
  
  hoverEnd = {
    interactionState = .rest
  }
}

usage MotionHoverChip {
  description = "Interaction state only — no animate = Timing sugar. Host patches styles immediately."
}

component MotionHoverFlourish <PointerInput>() layout {
  direction = .column
  gap = 6
  padding = 16
  width = 160
  background = #111827
  cornerRadius = 999
  children = [Text(content: "Flourish", color: #FFFFFF, fontSize: 14, fontWeight: 600)]

  self.hoverStart = {
    animate = Animation(
      keys: [
        Motion(duration: 140, ease: .out, pose: Pose(scale: 1.16, translateY: -4)),
        Motion(duration: 140, ease: .out, pose: Pose(scale: 0.98)),
        Motion(duration: 120, ease: .out, pose: .rest)
      ]
    )
  }
  self.hoverEnd = {
    animate = Animation(
      keys: [
        Motion(duration: 280, ease: .out, pose: .rest)
      ]
    )
  }
}

usage MotionHoverFlourish {
  description = "Sequential Motions through a pop, then .rest. hoverEnd authors return to .rest."
}

component MotionHoverPop <PointerInput>() layout {
  direction = .column
  gap = 6
  padding = 16
  width = 160
  background = #0F766E
  cornerRadius = 999
  children = [Text(content: "hoverPop", color: #FFFFFF, fontSize: 14, fontWeight: 600)]

  self.hoverStart = {
    animate = motion.hoverPop
  }
  self.hoverEnd = {
    animate = Animation(
      keys: [Motion(duration: 280, ease: .out, pose: .rest)]
    )
  }
}

usage MotionHoverPop {
  description = "Token holds at 1.04. hoverEnd authors return to .rest."
}

component MotionHoverPopOverride <PointerInput>() layout {
  direction = .column
  gap = 6
  padding = 16
  width = 200
  background = #7C3AED
  cornerRadius = 999
  children = [Text(content: "override", color: #FFFFFF, fontSize: 14, fontWeight: 600)]

  self.hoverStart = {
    animate = motion.hoverPopHeld
  }
  self.hoverEnd = {
    animate = Animation(
      keys: [Motion(duration: 280, ease: .out, pose: .rest)]
    )
  }
}

usage MotionHoverPopOverride {
  description = "Token holds at 1.12. hoverEnd is a separate Animation back to .rest."
}

component MotionStandingSpin(isLoading: Bool = true) layout {
  direction = .column
  gap = 6
  padding = 16
  width = 160
  align = .center
  background = #111827
  cornerRadius = 12
  let spinner = Text(content: "spin", color: #FBBF24, fontSize: 18, fontWeight: 700)
  children = [spinner]
  if isLoading {
    spinner.animate = motion.spin
  }
}

usage MotionStandingSpin {
  description = "Child spinner.animate = motion.spin while isLoading. Linear rotate 360 forever."
}

component MotionStandingSelf(isLoading: Bool = true) layout {
  direction = .column
  gap = 6
  padding = 16
  width = 160
  background = #1F2937
  cornerRadius = 12
  children = [Text(content: "self.animate", color: #E5E7EB, fontSize: 14, fontWeight: 600)]
  if isLoading {
    self.animate = motion.spin
  }
}

usage MotionStandingSelf {
  description = "Root self.animate = motion.spin while isLoading. Same loop as the child spinner."
}

component MotionPulse() layout {
  direction = .column
  gap = 6
  padding = 16
  width = 160
  background = #111827
  cornerRadius = 12
  children = [Text(content: "pulse", color: #F9A8D4, fontSize: 18, fontWeight: 700)]
  self.animate = motion.pulse
}

usage MotionPulse {
  description = "Standing keys through a dim/scale pole and .rest. repeat: .forever."
}

component MotionSheen() layout {
  direction = .row
  width = 160
  height = 36
  overflow = .clip
  cornerRadius = 8
  background = #111827
  let shine = Layout(width: 80, height: .fill, background: #FFFFFF, opacity: 0.28)

shine.blur = 12
  
  children = [shine]
  shine.animate = motion.sheen
}

usage MotionSheen {
  description = "Starts at translateX −80, eases to 160. Forever wrap is hidden by overflow: .clip."
}

component MotionAppearThenPulse <PointerInput>() layout {
  direction = .column
  gap = 6
  padding = 16
  width = 160
  background = #111827
  cornerRadius = 12
  children = [Text(content: "appear→pulse", color: #93C5FD, fontSize: 14, fontWeight: 700)]
  self.appear = {
    animate = Animation(
      start: Pose(opacity: 0),
      keys: [Motion(duration: 200, ease: .linear, pose: .rest)]
    )
  }
  self.animate = motion.pulse
}

usage MotionAppearThenPulse {
  description = "Appear fades opacity 0→1, then standing pulse takes the same channel."
}

component MotionBlurCard <PointerInput>() layout {
  direction = .column
  gap = 8
  padding = 20
  width = 280
  background = #FFFFFF
  cornerRadius = 12
  borderWidth = 1
  borderColor = #E5E7EB

  let title = Text(content: "In focus", color: #111827, fontSize: 16, fontWeight: 600)
  let body = Text(content: "Appear unblurs 18px → sharp.", color: #6B7280, fontSize: 13)
  children = [title, body]

  self.appear = {
    animate = Animation(
      start: Pose(blur: 18, opacity: 0.35),
      keys: [Motion(duration: 420, ease: .out, pose: .rest)]
    )
  }
  self.dismiss = {
    animate = Animation(
      keys: [
        Motion(duration: 280, ease: .in, pose: Pose(blur: 18, opacity: 0.35))
      ]
    )
  }
}

usage MotionBlurCard {
  description = "Pose.blur is a CSS filter overlay (px), not a Blur() layer. Appear goes 18px blur → sharp."
}

