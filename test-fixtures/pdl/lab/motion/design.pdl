component MotionPoseBlur <PointerInput>() layout {
  direction = .column
  gap = 6
  padding = 20
  width = 280
  background = #FFFFFF
  cornerRadius = 12
  borderWidth = 1
  borderColor = #E5E7EB

  let title = Text(content: "blur", color: #111827, fontSize: 16, fontWeight: 600)
  let body = Text(content: "16px → 0. Filter overlay, opacity stays 1.", color: #6B7280, fontSize: 13)
  children = [title, body]

  self.appear = {
    animate = Motion(
      transition: (duration: 420, easing: "ease-out"),
      pose: Pose(blur: 16)
    )
  }
  self.dismiss = {
    animate = Motion(
      transition: (duration: 280, easing: "ease-in"),
      pose: Pose(blur: 16)
    )
  }
}

