// media: source, contentMode, justify/align (content position), aspect sizing

import "tokens_color.pdl"
import "tokens_distance_radius.pdl"
import "tokens_icon_media_ratio.pdl"

component AtomMediaCover() layout {
  direction = .column
  background = atoms.color.sem.fromRgb

  let M = Media(
    source: atoms.media.hero,
    contentMode: .cover,
    justify: .center,
    align: .center,
    width: .fill,
    height: .aspect(atoms.ratio.video),
    cornerRadius: atoms.radius.sm
  )

  children = [M]
}

component AtomMediaContainCorners() layout {
  direction = .column
  background = atoms.color.sem.fromRgba

  let M = Media(
    source: "https://example.com/poster.jpg",
    contentMode: .contain,
    justify: .start,
    align: .start,
    width: .fill,
    height: .fixed(180),
    background: atoms.color.rgb
  )

  children = [M]
}

component AtomMediaScaleDown() layout {
  direction = .column
  background = atoms.color.rgba

  let M = Media(
    source: "media/local.png",
    contentMode: .scaleDown,
    justify: .end,
    align: .end,
    opacity: 0.92
  )

  children = [M]
}

component AtomMediaVideoKind() layout {
  direction = .column
  background = atoms.color.rgb

  let M = Media(
    source: atoms.media.opaqueClip,
    contentMode: .cover,
    width: .fill,
    height: .aspect(16:9)
  )

  children = [M]
}
