// layout `hidden` — variant-driven visibility without `if` on `children =`

import "typestyle_atoms.pdl"

variant AtomHiddenFrameMode {
  case showExtra
  case hideExtra
}

component AtomHiddenFrame(mode: AtomHiddenFrameMode = .showExtra) layout {
  direction = .column

  let A = Text(content: "Always", style: AtomCaption)

  let Inner = Text(content: "Sometimes", style: AtomBody)

  let B = Layout(direction: .row, children: [Inner])
  B.hidden = mode == .hideExtra

  children = [A, B]
}
