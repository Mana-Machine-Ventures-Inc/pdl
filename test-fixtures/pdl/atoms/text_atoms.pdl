// text: content, style, typography props, justify/align, overflow, truncateStyle, lineClamp

import "tokens_color.pdl"
import "tokens_distance_radius.pdl"
import "typestyle_atoms.pdl"

component AtomTextPlain() layout {
  direction = .column
  gap = atoms.space.sm
  background = atoms.color.sem.fromRgb

  let T = Text(
    content: "Plain text",
    color: atoms.color.rgba,
    fontSize: 14,
    fontWeight: 500,
    lineHeight: 1.35,
    letterSpacing: 0.01
  )

  children = [T]
}

component AtomTextTypeStyle() layout {
  direction = .column
  background = atoms.color.sem.fromRgba

  let A = Text(content: "Caption line", style: AtomCaption)

  let B = Text(content: "Body line", style: AtomBody)

  let C = Text(content: "Title line", style: AtomTitle)

  let D = Text(content: "Mono line", style: AtomMono)

  children = [A, B, C, D]
}

component AtomTextStylePlusOverride() layout {
  direction = .column
  background = atoms.color.sem.fromRgb

  let T = Text(content: "Mixed", style: AtomCaption, fontSize: 22)

  children = [T]
}

component AtomTextJustifyAlign() layout {
  direction = .row
  gap = atoms.space.md
  background = atoms.color.rgb

  let L = Text(
    content: "Left",
    justify: .start,
    align: .start,
    color: atoms.color.sem.fromRgb,
    fontSize: 12
  )

  let C = Text(
    content: "Center",
    justify: .center,
    align: .center,
    color: atoms.color.sem.fromRgba,
    fontSize: 12
  )

  let R = Text(
    content: "Right end",
    justify: .end,
    align: .end,
    color: atoms.color.rgba,
    fontSize: 12
  )

  children = [L, C, R]
}

component AtomTruncateStyle() layout {
  direction = .column
  gap = atoms.space.xs
  background = atoms.color.sem.fromRgb

  let Clipped = Text(
    content: "Very long label that should hard-clip with no ellipsis glyph when constrained",
    overflow: .clip,
    truncateStyle: .clip,
    lineClamp: 2,
    color: atoms.color.rgba,
    fontSize: 13,
    lineHeight: 1.4,
    width: .fixed(120)
  )

  let Ellipsis = Text(
    content: "Very long label that should ellipsize when constrained",
    overflow: .clip,
    truncateStyle: .ellipsis,
    lineClamp: 2,
    color: atoms.color.sem.fromRgba,
    fontSize: 13,
    width: .fixed(120)
  )

  children = [Clipped, Ellipsis]
}
