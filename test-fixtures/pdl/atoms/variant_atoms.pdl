// User-defined variant / enum types (finite closed sets; `enum` ≡ `variant`)

variant AtomsAxis {
  case horizontal
  case vertical
}

// Surface alias — same IR as `variant`
enum AtomsPhase {
  case rest
  case hovered
  case pressed
}

variant AtomsSize {
  case sm
  case md
  case lg
}

variant AtomsDensity {
  case comfortable
  case compact
}

variant AtomsTone {
  case neutral
  case accent
  case danger
}
