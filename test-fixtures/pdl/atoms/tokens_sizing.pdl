// Sizing as token RHS (rare per §3, but valid)
// Dot form and qualified `Sizing.*` form are equivalent.

primitive atoms.sizing.hug: Sizing = .hug
primitive atoms.sizing.fill: Sizing = Sizing.fill
primitive atoms.sizing.fixed: Sizing = .fixed(48)
primitive atoms.sizing.flex: Sizing = Sizing.flex(min: 8, max: 120)
