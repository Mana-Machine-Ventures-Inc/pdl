// Distance + Radius (scalar numbers; Corner(…) is frame-only on cornerRadius)

primitive atoms.space.xs: Distance = 4
primitive atoms.space.sm: Distance = 8
primitive atoms.space.md: Distance = 16
semantic atoms.space.card.pad: Distance = atoms.space.md

primitive atoms.radius.sm: Radius = 4
primitive atoms.radius.md: Radius = 8
semantic atoms.radius.card: Radius = atoms.radius.md
