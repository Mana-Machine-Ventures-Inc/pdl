// if / else if / else on frames driven by variant params

import "variant_atoms.pdl"
import "tokens_color.pdl"
import "tokens_distance_radius.pdl"

component AtomVariantSwatch(tone: AtomsTone = .neutral) layout {
  let Swatch = Layout(
    direction: .column,
    padding: EdgeInsets(x: atoms.space.md, y: atoms.space.sm),
    children: []
  )

  if tone == .accent {
    Swatch.background = atoms.color.rgb
  } else if tone == .danger {
    Swatch.background = atoms.color.rgba
  } else {
    Swatch.background = atoms.color.sem.fromRgb
  }

  children = [Swatch]
}

component AtomVariantAxis(axis: AtomsAxis = .horizontal) layout {
  let Box = Layout(gap: atoms.space.xs, children: [])

  if axis == .vertical {
    Box.direction = .column
    Box.background = atoms.color.sem.fromRgba
  } else {
    Box.direction = .row
    Box.background = atoms.color.sem.fromRgb
  }

  children = [Box]
}
