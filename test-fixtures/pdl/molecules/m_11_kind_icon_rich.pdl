// Variant-driven icon glyph + label copy + typeStyle swaps (matrix kind reused)

import "foundation.pdl"
import "m_04_button_variant_matrix.pdl"

component MoleculeKindRichRow(kind: MoleculeMatrixKind = .primary) layout {
  direction = .row
  justify = .start
  align = .center
  gap = atoms.space.sm
  padding = EdgeInsets(x: 14, y: 10)
  cornerRadius = atoms.radius.sm
  background = atoms.color.sem.fromRgb

  let G = Icon(icon: atoms.icon.star, size: 22, color: atoms.color.rgba)

  if kind == .primary {
    G.icon = atoms.icon.star
  } else if kind == .secondary {
    G.icon = atoms.icon.chevron
  } else {
    G.icon = IconRef(system: .sfSymbols, name: "xmark")
  }

  let L = Text(content: "Action", style: AtomBody)

  if kind == .primary {
    L.content = "Save changes"
    L.style = AtomCaption
  } else if kind == .secondary {
    L.content = "Learn more about billing"
  } else {
    L.content = "Permanently delete"
    L.style = AtomTitle
  }

  children = [G, L]
}

component MoleculeKindRichGallery() layout {
  direction = .column
  gap = atoms.space.sm
  padding = EdgeInsets(x: 16, y: 16)
  background = atoms.color.rgb

  let A = MoleculeKindRichRow(kind: .primary)
  let B = MoleculeKindRichRow(kind: .secondary)
  let C = MoleculeKindRichRow(kind: .danger)
  children = [A, B, C]
}
