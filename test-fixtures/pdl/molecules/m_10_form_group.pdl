// Form-like vertical group: label stack + “field” row + helper + actions

import "foundation.pdl"
import "m_02_buttons_basic.pdl"

variant MoleculeFieldBlockLayout {
  case includeHelp
  case noHelp
}

component MoleculeFieldBlock <PointerInput>(
  label: String = "Email",
  value: String = "you@example.com",
  helper: String = "We never share your address.",
  layoutMode: MoleculeFieldBlockLayout = .includeHelp
) layout {
  direction = .column
  align = .stretch
  gap = atoms.space.xs
  padding = EdgeInsets(x: 0, y: atoms.space.sm)

  let Lab = Text(content: label, style: AtomCaption)

  let Val = Text(content: value, style: AtomBody)

  let Box = Layout(
    direction: .row,
    align: .center,
    padding: EdgeInsets(x: 12, y: 10),
    cornerRadius: atoms.radius.sm,
    borderWidth: 1,
    borderColor: atoms.color.rgba,
    background: atoms.color.sem.fromRgb,
    children: [Val]
  )

  let Help = Text(content: helper, style: AtomMono)

  if layoutMode == .includeHelp {
    children = [Lab, Box, Help]
  } else {
    children = [Lab, Box]
  }

  self.hoverStart = {
    layoutMode = .noHelp
  }
  self.hoverEnd = {
    layoutMode = .includeHelp
  }
}

component MoleculeFormColumnDemo() layout {
  direction = .column
  align = .stretch
  gap = atoms.space.md
  padding = EdgeInsets(x: atoms.space.md, y: atoms.space.md)
  width = .fill
  height = .hug
  background = atoms.color.sem.fromRgba

  let F0 = MoleculeFieldBlock(label: "Workspace", value: "Design", helper: "Renaming updates the slug.")
  let F1 = MoleculeFieldBlock(label: "Role", value: "Editor", helper: "")
  let Cancel = MoleculeTextButton(label: "Cancel", tone: .secondary, size: .sm)
  let Save = MoleculeTextButton(label: "Save", tone: .primary, size: .lg)
  let Actions = Layout(
    direction: .row,
    justify: .end,
    gap: atoms.space.sm,
    padding: EdgeInsets(top: atoms.space.sm, right: 0, bottom: 0, left: 0),
    children: [Cancel, Save]
  )

  children = [F0, F1, Actions]
}
