// Simple labels in fixed layouts + alignment sweeps

import "foundation.pdl"

component MoleculeLabelStack() layout {
  direction = .column
  gap = atoms.space.sm
  padding = EdgeInsets(x: atoms.space.md, y: atoms.space.md)
  background = atoms.color.sem.fromRgb

  let A = Text(content: "Caption", style: AtomCaption)

  let B = Text(content: "Title line", style: AtomTitle)

  let C = Text(content: "Muted supporting copy", style: AtomBody)

  children = [A, B, C]
}

component MoleculeLabelRowJustifySweep() layout {
  direction = .column
  gap = atoms.space.md
  background = atoms.color.sem.fromRgba

  let LStart = Text(
    content: "Start",
    fontSize: 14,
    color: atoms.color.sem.fromRgb
  )
  let RowStart = Layout(
    direction: .row,
    justify: .start,
    align: .center,
    gap: atoms.space.sm,
    children: [LStart]
  )

  let A = Text(content: "A", fontSize: 12, color: atoms.color.rgb)
  let B = Text(content: "B", fontSize: 12, color: atoms.color.rgba)
  let RowBetween = Layout(
    direction: .row,
    justify: .spaceBetween,
    align: .center,
    gap: atoms.space.sm,
    children: [A, B]
  )

  let LEnd = Text(
    content: "End",
    fontSize: 14,
    color: atoms.color.sem.fromRgba
  )
  let RowEnd = Layout(
    direction: .row,
    justify: .end,
    align: .stretch,
    gap: atoms.space.xs,
    children: [LEnd]
  )

  children = [RowStart, RowBetween, RowEnd]
}

component MoleculeThreeColumnLabels() layout {
  direction = .row
  justify = .stretch
  align = .stretch
  wrap = .nowrap
  gap = atoms.space.md
  padding = EdgeInsets(x: 12, y: 12)
  background = atoms.color.rgb

  let T1 = Text(
    content: "Column 1",
    fontSize: 13,
    color: atoms.color.sem.fromRgb
  )
  let Col1 = Layout(
    direction: .column,
    align: .start,
    gap: 4,
    children: [T1]
  )

  let T2 = Text(
    content: "Column 2",
    fontSize: 13,
    color: atoms.color.sem.fromRgba
  )
  let Col2 = Layout(
    direction: .column,
    align: .center,
    gap: 4,
    children: [T2]
  )

  let T3 = Text(content: "Column 3", fontSize: 13, color: atoms.color.rgba)
  let Col3 = Layout(
    direction: .column,
    align: .end,
    gap: 4,
    children: [T3]
  )

  children = [Col1, Col2, Col3]
}
