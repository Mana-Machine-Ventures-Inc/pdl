import "foundation.pdl"

type IosPageCount = Number(min: 2, max: 10)

component IosPageDot(
  selected: Bool = false
) layout {
  direction = .row
  width = 8
  height = 8
  cornerRadius = 50

  if selected {
    background = ios.color.pageDot.active
  } else {
    background = ios.color.pageDot.idle
  }
}

// Folded from Figma Page control — count + selection as Numbers + Repeat.
component IosPageControl(
  numberOfPages: IosPageCount = 3,
  currentPage: Number(min: 1) = 1
) layout {
  direction = .row
  align = .center
  justify = .center
  gap = 8
  padding = EdgeInsets(x: 12, y: 8)
  height = 24
  width = .hug

  children = Repeat(count: numberOfPages) { i in
    IosPageDot(selected: i == currentPage)
  }
}
