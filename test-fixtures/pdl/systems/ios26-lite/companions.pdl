import "c_toggle.pdl"
import "c_segmented.pdl"
import "c_button.pdl"
import "c_field.pdl"
import "c_tabbar.pdl"
import "c_list.pdl"
import "c_navbar.pdl"
import "c_slider.pdl"
import "c_stepper.pdl"
import "c_progress.pdl"
import "c_pagecontrol.pdl"
import "c_materials.pdl"
import "screens.pdl"
import "demos.pdl"

usage IosToggle {
  description = "A toggle chooses between opposing states (on / off). Folded from Figma Toggle - Switch (On/Off + Show AX Label)."
}

usage IosSegmentedControl {
  description = "A linear set of two or more segments. Folded from Figma's 14-variant Segmented control set (Segments × Selected) into count + selected + labels."
}

usage IosButton {
  description = "Content-area button. Folded from Figma's 145-variant Button - Content Area into size × style × isEnabled × destructive (text label only; Symbol / Liquid Glass deferred)."
}

usage IosTextField {
  description = "Single-line text field. Folded from Figma Text Field's 4 states (Placeholder / Focused / Value Entered / Typing) into EditableText isEmpty × isEditing + placeholder."
}

usage IosTabBar {
  description = "iPhone tab bar capsule. Folded from Figma Tab Bar - iPhone (Tabs 2–5) into count + selected + labels/icons; Separate Search, Minimized, and true Liquid Glass deferred."
}

usage IosListRow {
  description = "Settings-style list row. Folded from Figma Lists Row (Regular/Tall) + _Trailing (detail / disclosure / toggle). Leading image and edit controls deferred."
}

usage IosNavBar {
  description = "Top toolbar / navigation bar. Folded from Figma Toolbar - Top - iPhone Default + Large Title; chrome buttons are labeled glass capsules (symbols deferred)."
}

usage IosSlider {
  description = "Continuous slider. Folded from Figma Sliders (0/25/50/75/100%) into discrete IosSliderValue levels; live drag deferred."
}

usage IosStepper {
  description = "Increment / decrement capsule. Folded from Figma Steppers Stepper (− / + with center separator)."
}

usage IosProgressBar {
  description = "Determinate progress track. Folded from Figma Progress bar (0–100% steps) into discrete IosProgressValue levels; activity spinner deferred."
}

usage IosPageControl {
  description = "Carousel page dots. Map(1…n) → [IosPageDot], ForEach for selection + emit; HIG ceilings via Number bounds."
}

usage IosMaterialSwatch {
  description = "System material swatch. Folded from Figma Materials Ultrathin…Chrome + Light/Dark fills; BACKGROUND_BLUR → Effect(.blurBehind). IC modes deferred."
}

usage IosLiquidGlassTile {
  description = "Liquid Glass stand-in. Figma GLASS / PDL Effect(.glass) reserved — translucent fill + blurBehind + shadow."
}

usage IosSettingsPage {
  description = "Settings destination page — large nav + Network list. Tab chrome lives on IosPhone, not inside the page."
}

usage IosPhone {
  description = "Phone screen — Presenter(root:) + interactive frosted tabs (goHome / goSearch / goSettings → replace)."
}

fixtures IosToggle {
  example "On" {
    isOn = true
    showAXLabel = true
  }
  example "Off" {
    isOn = false
    showAXLabel = true
  }
  example "On · Dark" {
    isOn = true
    theme = "Dark"
  }
  example "Off · Dark" {
    isOn = false
    theme = "Dark"
  }
}

fixtures IosSegmentedControl {
  example "Two segments" {
    count = .two
    selected = .one
    label1 = "Year"
    label2 = "Month"
  }
  example "Three segments" {
    count = .three
    selected = .two
    label1 = "Day"
    label2 = "Week"
    label3 = "Month"
  }
  example "Five segments" {
    count = .five
    selected = .three
    label1 = "One"
    label2 = "Two"
    label3 = "Three"
    label4 = "Four"
    label5 = "Five"
  }
  example "Two · Dark" {
    count = .two
    selected = .one
    label1 = "Year"
    label2 = "Month"
    theme = "Dark"
  }
}

fixtures IosButton {
  example "Prominent" {
    label = "Continue"
    style = .prominent
    size = .medium
  }
  example "Bordered" {
    label = "Edit"
    style = .bordered
    size = .medium
  }
  example "Secondary" {
    label = "More"
    style = .secondary
    size = .medium
  }
  example "Borderless" {
    label = "Cancel"
    style = .borderless
    size = .medium
  }
  example "Destructive" {
    label = "Delete"
    style = .prominent
    size = .medium
    destructive = true
  }
  example "Disabled" {
    label = "Unavailable"
    style = .prominent
    size = .medium
    isEnabled = false
  }
  example "Large · Dark" {
    label = "Continue"
    style = .prominent
    size = .large
    theme = "Dark"
  }
}

fixtures IosTextField {
