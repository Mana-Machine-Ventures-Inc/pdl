import "foundation.pdl"

component AbnField(
  label: String = "Email",
  value: String = "you@example.com",
  helper: String = "We never share your address."
) layout {
  direction = .column
  align = .stretch
  gap = abn.space.xs
  padding = EdgeInsets(x: 0, y: abn.space.sm)

  let Lab = Text(
    content: label,
    style: AbnCaption,
    color: abn.color.textMuted
  )

  let Val = Text(content: value, style: AbnBody, color: abn.color.text)

  let Box = Layout(
    direction: .row,
    align: .center,
    padding: EdgeInsets(x: 12, y: 12),
    cornerRadius: abn.radius.sm,
    borderWidth: 1,
    borderColor: abn.color.border,
    background: abn.color.surface,
    children: [Val]
  )

  let Help = Text(
    content: helper,
    style: AbnCaption,
    color: abn.color.textMuted
  )

  children = [Lab, Box, Help]
}
