// PlaygroundCompose — spatial compose output (Phase P2). Regenerated by the Playground UI.

component PlaygroundCompose() layout {
  direction = .column
  align = .start
  justify = .start
  wrap = .nowrap
  gap = abn.space.md
  padding = EdgeInsets(x: abn.space.lg, y: abn.space.lg)
  background = abn.color.canvas
  width = .fill
  height = .hug

  children = []
}
