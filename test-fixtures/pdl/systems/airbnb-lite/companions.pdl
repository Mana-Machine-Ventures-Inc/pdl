import "c_button.pdl"
import "c_field.pdl"
import "c_chip.pdl"
import "demos.pdl"

fixtures AbnButton {
  example "Primary large" {
    label = "Reserve"
    tone = .primary
    size = .lg
  }
  example "Secondary small" {
    label = "Message host"
    tone = .secondary
    size = .sm
  }
  example "Ghost dismiss" {
    label = "Not now"
    tone = .ghost
    size = .sm
  }
  example "Hovered" {
    label = "Reserve"
    tone = .primary
    size = .lg
    interactionState = .hovered
  }
  example "Pressed" {
    label = "Reserve"
    tone = .primary
    size = .lg
    interactionState = .pressed
  }
}

fixtures AbnField {
  example "Email" {
    label = "Email"
    value = "guest@airbnb.com"
    helper = "Confirmation goes here."
  }
  example "Phone" {
    label = "Phone"
    value = "+1 415 555 0132"
    helper = ""
  }
}

fixtures AbnChip {
  example "Selected" {
    title = "Homes"
    state = .selected
  }
  example "Idle" {
    title = "Experiences"
    state = .idle
  }
}

fixtures AbnPointerLab {
  example "Rest" {
    interactionState = .rest
  }
  example "Hovered" {
    interactionState = .hovered
  }
  example "Pressed" {
    interactionState = .pressed
  }
}

usage AbnButton {
  description = "Airbnb-lite text button — primary coral, secondary teal, ghost neutral. Inline interaction drives rest → hovered → pressed."
}

usage AbnPointerLab {
  description = "Interactive pointer-cycle lab — inline interaction { } handlers applied by the HTML preview host."
}

usage AbnField {
  description = "Labeled field with value row and optional helper."
}
