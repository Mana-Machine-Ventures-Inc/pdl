import "foundation.pdl"
variant AbnBtnTone {
  case primary
  case secondary
  case ghost
}

variant AbnBtnSize {
  case sm
  case lg
}

variant AbnBtnInteraction {
  case rest
  case hovered
  case pressed
}

component SimpleChip(
  title: String = "All"
) text {
  content = title
}

component AbnButton (
  label: String = "Button",
  tone: AbnBtnTone = .primary,
  size: AbnBtnSize = .sm,
  interactionState: AbnBtnInteraction = .rest,
  simple:SimpleChip = SimpleChip(title: "Simple Chippy")
) layout {
  direction = .row
  justify = .center
  align = .center
  wrap = .nowrap
  gap = abn.space.xs
  cornerRadius = abn.radius.pill

  if tone == .primary {
    background = abn.color.brand
  } else if tone == .secondary {
    background = abn.color.brandSecondary
  } else {
    background = abn.color.ghostFill
  }

  if size == .sm {
    padding = EdgeInsets(x: 14, y: 8)
  } else {
    padding = EdgeInsets(x: 22, y: 14)
  }

  if interactionState == .hovered {
    if tone == .primary {
      background = abn.color.brandHover
    } else if tone == .secondary {
      background = abn.color.brandSecondaryHover
    } else {
      background = abn.color.ghostHover
    }
    opacity = 1
  } else if interactionState == .pressed {
    if tone == .primary {
      background = abn.color.brandPressed
    } else if tone == .secondary {
      background = abn.color.brandSecondaryPressed
    } else {
      background = abn.color.ghostPressed
    }
    opacity = 1
  } else {
    opacity = 1
  }

  let L = Text(content: label, fontSize: 15, fontWeight: 600)

  if tone == .ghost {
    L.color = abn.color.text
  } else {
    L.color = abn.color.onBrand
  }

  simple.content = "Override content"
  simple.padding = 50

  children = [L, simple]
}
