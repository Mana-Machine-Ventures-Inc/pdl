component LabText() text {
  content = "Hello"
  color = red
  style = BodyToken
  //background = #000 @ 0.3
  // These are intrinsically hugging themselves, because they do not have width or height set
}

primitive spacing: Distance = 24

component LabLayout() layout {
  direction = .row

  width = 400
  height = 100
  // size = 150 // TODO: This should probably work
  background = #999 @ 0.3

  let A = LabText()
  A.background = #777 @ 0.3
  justify = .center
  align = .center
  gap = 8

  let C = LabCard(title: "Long test title")

  children = [A, LabMedia(), C]

  cornerRadius = Corner(tl: 12, tr: 32, br: 12, bl: 0)
  borderWidth = 3
  borderColor = #FF0000
  borderPosition = .inside
  borderPosition = .outside

  shadow = shadow1

  overflow = .scroll
}

// Icon token type; asset ctor is IconRef (Icon(…) is the World A icon *frame*)
primitive icon.star1: Icon = "icons/star.svg"
primitive icon.star2: Icon = IconRef(file: "icons/star.svg")
primitive icon.star3: Icon = IconRef(system: .sfSymbols, name: "star")
primitive icon.star4: Icon = IconRef(system: .materialSymbols, name: "star")

