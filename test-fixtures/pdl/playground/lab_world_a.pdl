// Phase 6 - Composition
// Phase 6.1 - Structure - Good
// Phase 6.2 - Spacer - good
// Phase 6.3 - Layout and text - good


component LabCard(
  title: String = "Title"
) layout {
  direction = .row
  padding = 16
  cornerRadius = 12
  background = #000 @ 0.1
  justify = Justify.spaceAround

  let Title = Text(content: title)

  children = [Title]
}

component LabLayoutTester() layout {
  direction = .row
  align = .center
  background = #000 @ 0.1
  width = 300
  height = 100

  let Green = Text(
    content: "Green",
    alignSelf: .end,
    color: #000,
    background: #0F0 @ 0.3
  )

  let Red = Text(
    content: "Red",
    grow: 1,
    width: .hug,
    color: #000,
    background: #F00 @ 0.3
  )

  children = [Green, Red]
}

// Phase 7 - Parameters

variant Tone {
  case primary
  case secondary
  case danger
}

component LabButton(
  label: String = "Button",
  label2: String = "Label2",
  tone: Tone = .primary,
  selected: Bool = false
) layout {
  direction = .row
  padding = EdgeInsets(x: 16, y: 10)
  cornerRadius = 8

  if tone == .primary && selected != false {
    // Special case
    background = #FFC0CB
  } else if tone == .primary {
    background = #00F
  } else if tone == .secondary {
    background = #888
  } else {
    background = #F00
  }

  if selected {
    borderColor = #000
    borderWidth = 4
    borderPosition = .inside
  }

  let Label = Text(content: label, color: #FFF, style: BodyToken)

  children = [Label]
}

// Phase 8 - multi component - Works

component LabRow() layout {
  direction = .row
  gap = 12

  let Cancel = LabButton(label: "Cancel", tone: .secondary)
  let Save = LabButton(label: "Save", tone: .primary)

  children = [Cancel, Save]
}

// Phase 9 - All works as expected

primitive blur.heavy: Radius = 2
primitive vibrancy.standard: Vibrancy = Vibrancy(saturation: 1.4, brightness: 1.1)

theme MaximumBlur {
  blur.heavy = 128
}

component LabLayers() layout {
  width = 240
  height = 240
  background = #333

  let ramp = Ramp(
    direction: .bottomToTop,
    stops: [
      GradientStop(color: #F00, opacity: 1, position: 0.0),
      GradientStop(color: #00F, opacity: 1, position: 1)
    ]
  )

  background = [#FFF, ramp, #000 @ 0.5]

  let Pic = LabMedia() // Media *component* instance (image frame)
  Pic.width = .aspect(2:1)
  children = Pic @ 0.5

  foreground = Blur(radius: blur.heavy, style: .standard, vibrancy: vibrancy.standard)

  //foreground = Blur(radius: 12, style: .standard, vibrancy: 5) // PDL-E040 — not Vibrancy
  //foreground = Blur(radius: 12, style: .standard, vibrancy: .standard) // PDL-E040 — BlurStyle ≠ Vibrancy
  //foreground = Blur(radius: 12, vibrancy: Vibrancy(saturation: 1.2, brightness: 1.05)) // typed inline Vibrancy
}

// Phase 10.1 and 10.2 - Host and emits and ForEach

enum LabState {
  case idle
  case hovered
  case pressed
}

component LabPress <PointerInput>(
  interactionState: LabState = .idle
) layout {
  let Label = Text(content: "Press me")

  if self.interactionState == .hovered {
    Label.content = "Hovered"
  } else if interactionState == .pressed {
    Label.content = "Pressing"
  }

  children = [Label]

  self.hoverStart = {
    interactionState = .hovered
  }

  hoverEnd = {
    interactionState = .idle
  }

  self.pressStart = {
    interactionState = .pressed
  }

  pressEnd = {
    interactionState = .hovered
  }

  self.pressCancel = {
    interactionState = .idle
  }
}

// 10.3 Emit and parent capture

enum FilterId {
  case all
  case podcasts
}

component LabChip <PointerInput>(
  filter: FilterId = .all,
  selected: Bool = false
) layout {
  // Empty Text frame — World A ctor (not `Text()` as a component instance)
  let Label = Text()

  if filter == .all {
    Label.content = "All"
  } else if filter == .podcasts {
    Label.content = "Podcasts"
  }

  if selected {
    background = #000
    Label.color = #FFF
  } else {
    background = #EEE
    Label.color = #000
  }

  children = [Label]

  self.pressEnd = {
    emit select(filter)
  }
} emits {
  select(filter: FilterId)
}

// `emits` is a trailer on a full component decl — not a standalone `component LabChip emits { }`

component LabBar(
  currentFilter: FilterId = .all,
  chips: [LabChip] = [LabChip(filter: .all), LabChip(filter: .podcasts)]
) layout {
  gap = 12

  ForEach(chips) { chip in
    if self.currentFilter == filter {
      chip.selected = true
    } else {
      chip.selected = false
    }

    chip.select(filter_id: FilterId) = {
      currentFilter = filter_id
    }
  }

  children = chips
}
