// Phase 0.1 - Primitives

primitive red: Color = #F00
primitive red2: Color = #FF0000
primitive red3: Color = #FF000099
primitive red4: Color = #FF0000 @ 0.5
primitive red5: Color = #FF0000 @ shield2
// primitive red5: Color = #FF0000 @ shield2 // Correctly fails

theme Blue {
  red = #00F
}

theme Dark {
  red = #000
}

primitive shield1: Opacity = 0.1
primitive shield2: Opacity = 0.5
primitive shield3: Opacity = 0.9
// primitive shield4: Opacity = red // Correctly fails

primitive distance1: Distance = 4
primitive distance2: Distance = 12
primitive distance3: Distance = 32
// primitive distance4: Distance = "a" // Correctly fails

primitive radius1: Radius = 32
// primitive radius2: Radius = distance1 // Correctly fails
// primitive radius2: Radius = Corner(tl: 1, tr: 1, br: 1, bl: 1) // Correctly fails
// primitive radius3: Radius = distance3 // This correctly fails

primitive shadow1: Shadow = Shadow(x: 6, y: 6, blurRadius: 12, spread: 0, color: #000000 @ 1.0)

// primitive shadow3: Shadow = Shadow(x: 6, y: 6, blurRadius: 12, spread: 0, color: #000000 @ 1.5) // Correctly fails as 1.5 is out of bounds for a color opacity

// primitive shadow2: Shadow = Shadow(x: red, y: 1.5, blurRadius: 3, spread: 0, color: #000000 @ 0.35) // Correctly fails as red is another primitive token, and also not the right format

primitive ratio1: Ratio = 1.77
// primitive ratio2: Ratio = "1.77" // Correctly fails
primitive ratio2: Ratio = 16:9 // W:H sugar

primitive font: FontFamily = "Georgia, system-ui, sans-serif" // TODO: Works but need confirmation in window
primitive font4: FontFamily = "FakeFontHere, system-ui, serif" // Correctly shows "??????" in preview

// primitive font2: FontFamily = 2 // Correctly fails
// primitive font3: FontFamily = #FF0000 // Correctly fails
// primitive font4: FontFamily = shield1 // Correctly fails

primitive fontSize1: Size = 16
// primitive fontSize2: Size = "16" // Correctly fails
// primitive fontSize3: Size = red // Correctly fails
primitive fontSize4: Size = 72

primitive fontWeight1: Weight = 400
//primitive fontWeight2: Weight = "500" // Correctly fails
// primitive fontWeight3: Weight = fontSize1 // Correctly fails
primitive fontWeight4: Weight = 800

primitive lineHeight1: LineHeight = 1
primitive lineHeight2: LineHeight = 1.5
primitive letterSpacing1: LetterSpacing = 0
primitive letterSpacing2: LetterSpacing = 0.1

semantic body.lineheight: LineHeight = lineHeight1
semantic body.lineheight2: LineHeight = lineHeight2

typeStyle BodyToken {
  fontFamily = font
  fontSize = fontSize1
  fontWeight = fontWeight4
  lineHeight = body.lineheight2
  letterSpacing = letterSpacing2
}

primitive sizing1: Sizing = Sizing.hug
primitive sizing2: Sizing = .hug
// primitive sizing3: Sizing = ".hug" // Correctly fails

primitive sizing4: Sizing = .fill // Correctly works
//primitive sizing5: Sizing = .fixed // Correctly fails, but should warn that it is expecting a Distance Number
primitive sizing5: Sizing = .fixed(24)
primitive sizing6: Sizing = .flex(min: 0, max: 120) // Correctly works


// Phase 0.2 - Semantics
// semantic red: Color = red // Correctly fails
semantic primaryColor1: Color = red
semantic primaryColorOpacity: Opacity = shield1
semantic primaryColorAndOpacity1: Color = red @ shield1
semantic primaryColorAndOpacity2: Color = primaryColor1 @ primaryColorOpacity

