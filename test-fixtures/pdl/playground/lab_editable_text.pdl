// EditableText sessioaans — try each component in Playground HTML preview.
//
// MyTextField       — default .focus; handlers optional
// PressOnlyField    — .press: click begins; bare focus does not
// ProgramOnlyField  — .none: click does nothing; fixture / param isEditing
// NoteEditor        — parent-owned session; field .press or Edit opens
//                     (began / finished / cancelled emit funnel)

component MyTextField <EditableText>() text {
  fontSize = 16
  padding = EdgeInsets(x: 12, y: 10)
  cornerRadius = 8
  background = #F4F4F5
  borderWidth = 1
  borderColor = #E4E4E7
  width = 320
  content = value

  if isEditing {
    background = #FFFFFF
    borderColor = #2563EB
    borderWidth = 2
  } else if isEmpty {
    content = "Type here… (.focus)"
    color = #A1A1AA
  }
}

component PressOnlyField <EditableText>(
  activatesOn: TextFieldActivation = .press
) text {
  fontSize = 16
  padding = EdgeInsets(x: 12, y: 10)
  cornerRadius = 8
  background = #F4F4F5
  borderWidth = 1
  borderColor = #E4E4E7
  width = 320
  content = value

  if isEditing {
    background = #FFFFFF
    borderColor = #16A34A
    borderWidth = 2
  } else if isEmpty {
    content = "Click to edit (.press)"
    color = #A1A1AA
  }
}

component ProgramOnlyField <EditableText>(
  activatesOn: TextFieldActivation = .none
) text {
  fontSize = 16
  padding = EdgeInsets(x: 12, y: 10)
  cornerRadius = 8
  background = #F4F4F5
  borderWidth = 1
  borderColor = #E4E4E7
  width = 320
  content = value

  if isEditing {
    background = #FFFFFF
    borderColor = #C026D3
    borderWidth = 2
  } else if isEmpty {
    content = "Set isEditing in params (.none)"
    color = #A1A1AA
  } else {
    content = value
  }
}

// --- NoteEditor: parent orchestrates the session --------------------------------
// Parent SoT: committed / draft / editing (shell chrome).
// Open / close funnel through NoteField emits (began / finished / cancelled):
//   Edit click + field .press → began; Done/Enter → finished; Cancel/Esc → cancelled.
//   Buttons only request Input.beginEditing / finishEditing / cancelEditing.

variant EditorBtnTone {
  case primary
  case secondary
}

variant EditorBtnState {
  case idle
  case hovering
}

component EditorBtn <PointerInput>(
  label: String = "Go",
  tone: EditorBtnTone = .primary,
  state: EditorBtnState = .idle
) layout {
  direction = .row
  padding = EdgeInsets(x: 14, y: 8)
  cornerRadius = 6

  if tone == .primary {
    background = #2563EB
  } else {
    background = #E4E4E7
  }

  if state == .hovering {
    background = #FFFFFF
  }

  let L = Text(content: label, fontSize: 13)
  if tone == .primary {
    L.color = #FFFFFF
  } else {
    L.color = #18181B
  }
  if state == .hovering {
    L.color = #18181B
  }
  children = [L]

  pressEnd = { emit tap() }
  hoverStart = { state = .hovering }
  hoverEnd = { state = .idle }
} emits {
  tap()
}

component NoteField <EditableText>(
  activatesOn: TextFieldActivation = .press
) text {
  fontSize = 16
  padding = EdgeInsets(x: 12, y: 10)
  content = value
  background = #FFFFFF
  borderWidth = 1
  borderColor = #E4E4E7
  cornerRadius = 8
  width = 328

  if isEditing {
    borderColor = #2563EB
    borderWidth = 2
  } else if isEmpty {
    content = "Write a note…"
    color = #A1A1AA
  }

  editingBegan = {
    emit began(value)
  }
  editingFinished = {
    finishEditing()
    emit finished(value)
  }
  editingCancelled = {
    cancelEditing()
    emit cancelled(value)
  }
} emits {
  began(value: String)
  finished(value: String)
  cancelled(value: String)
}

component NoteEditor(
  committed: String = "Ship EditableText",
  draft: String = "Ship EditableText",
  editing: Bool = false,
  status: String = "Idle — click the field or Edit to start"
) layout {
  direction = .column
  gap = 10
  padding = 16
  width = 360
  background = #FAFAFA
  cornerRadius = 12
  borderWidth = 1
  borderColor = #E4E4E7

  let Eyebrow = Text(content: "Committed title", fontSize: 11, color: #A1A1AA)
  let Title = Text(content: committed, fontSize: 18, color: #18181B)
  let Hint = Text(
    content: "activatesOn=.press — field click or Edit opens; Done/Enter save; Cancel/Esc discard",
    fontSize: 11,
    color: #71717A
  )
  let Input = NoteField(value: draft, isEditing: editing)
  let Edit = EditorBtn(label: "Edit", tone: .primary)
  let Cancel = EditorBtn(label: "Cancel", tone: .secondary)
  let Done = EditorBtn(label: "Done", tone: .primary)
  let Status = Text(content: status, fontSize: 12, color: #52525B)

  if editing {
    Eyebrow.content = "Draft (session buffer)"
    Title.content = draft
    children = [Eyebrow, Title, Hint, Input, Cancel, Done, Status]
  } else {
    children = [Eyebrow, Title, Hint, Input, Edit, Status]
  }

  // Thin verb wrappers — shell SoT updates in began / finished / cancelled captures.
  Edit.tap() = { Input.beginEditing(committed) }
  Done.tap() = { Input.finishEditing() }
  Cancel.tap() = { Input.cancelEditing() }
  Input.began(value: String) = {
    draft = value
    editing = true
    status = "Editing — Done / Enter save; Cancel / Esc discard"
  }
  Input.finished(value: String) = {
    draft = value
    committed = value
    editing = false
    status = "Saved"
  }
  Input.cancelled(value: String) = {
    draft = committed
    editing = false
    status = "Cancelled — committed text unchanged"
  }
}

fixtures MyTextField {
  example "Empty" { value = "" }
  example "Seeded" { value = "Hello" }
}

fixtures PressOnlyField {
  example "Seeded" { value = "Press-only" }
}

fixtures ProgramOnlyField {
  example "Idle" {
    value = "Program-only"
    isEditing = false
  }
  example "Force edit" {
    value = "Program-only"
    isEditing = true
  }
}

fixtures NoteEditor {
  example "Idle" {
    committed = "Ship EditableText"
    draft = "Ship EditableText"
    editing = false
    status = "Idle — click the field or Edit to start"
  }
  example "Mid-edit" {
    committed = "Ship EditableText"
    draft = "Ship EditableText with Done/Cancel"
    editing = true
    status = "Fixture forced editing session"
  }
  example "Empty draft" {
    committed = "Untitled"
    draft = ""
    editing = true
    status = "Empty session — placeholder on NoteField"
  }
}
