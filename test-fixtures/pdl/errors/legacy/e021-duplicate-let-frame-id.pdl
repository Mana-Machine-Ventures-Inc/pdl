// PDL-E021: duplicate `let` / `letInstance` ids anywhere in the component body (including sibling nested frames).

component DupFrameIds() layout {
  direction = .column

  let Dup = Text(content: "a")
  let OuterA = Layout(direction: .column, children: [Dup])

  let Dup = Text(content: "b")
  let OuterB = Layout(direction: .column, children: [Dup])

  children = [OuterA, OuterB]
}
