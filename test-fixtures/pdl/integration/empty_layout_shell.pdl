// Minimal layout: no imports, no tokens, no themes — slot chain + `embed: nested` rewires tree and embeds a `DeepSlot()` instance for deep JSON tests.


primitive local.atoms.color.rgb: Color = #D4A574
semantic local.atoms.color.sem.fromRgb: Color = local.atoms.color.rgb

variant EmptyLayoutEmbed {
  case flat
  case nested
}

component EmptyLayoutShell(embed: EmptyLayoutEmbed = .flat) layout {
  direction = .column
  align = .stretch

  let DSlot = DeepSlot()

  let SlotOne = Layout(
    direction: .column,
    align: .stretch,
    width: .fill,
    height: .fill,
    background: local.atoms.color.sem.fromRgb
  )

  let SlotTwo = Layout(
    direction: .row,
    align: .stretch,
    width: .fill,
    height: .fill
  )

  let SlotThree = Layout(direction: .column, width: .fill, height: .fill)

  children = [SlotOne]
  SlotOne.children = [SlotTwo]
  SlotTwo.children = [SlotThree]
  SlotThree.children = []

  if embed == .nested {
    SlotOne.children = [DSlot]
    SlotTwo.children = [SlotOne]
    SlotThree.children = [SlotTwo]
    children = [SlotThree]
  }
}

component DeepSlot() layout {
  direction = .column
  width = .fill
  height = .fill
  background = local.atoms.color.sem.fromRgb
}