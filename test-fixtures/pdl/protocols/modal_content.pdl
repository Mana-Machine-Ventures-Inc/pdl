// B1+B2: protocols, [T] slots, instance literals, children expansion.
protocol ModalContent: component {
  title = "Modal Title"
  subtitle = "Subtitle" // Can be ignored
}

component UpsellBody emits <ModalContent>(
  cta: String = "Upgrade"
) layout {
  direction = .column

  let Title = Text(content: title)
  let Sub = Text(content: subtitle)
  let Cta = Text(
    content: cta,
    fontSize: 32,
    background: #009999,
    padding: EdgeInsets(x: 0,
    y: 12)
  )
  children = [Title, Sub, Cta]
}

component ConfirmBody emits <ModalContent>() layout {
  direction = .column

  let Title = Text(content: title)

  let Sub = Text(content: subtitle)
  children = [Title, Sub]
}

component Modal(
  chromeTitle: String = "Dialog",
  slots: [ModalContent] = [UpsellBody(), ConfirmBody()]
) layout {
  direction = .column
  gap = 12

  let Header = Text(content: chromeTitle)
  children = [Header, slots]
}
