// B1+B2: protocols, [T] slots, instance literals, children expansion.
protocol ModalContent {
  title = "Modal Title"
  subtitle = ""
}

component UpsellBody <ModalContent>(
  cta: String = "Upgrade"
) layout {
  let Title: text = {
    content = title
  }
  let Sub: text = {
    content = subtitle
  }
  let Cta: text = {
    content = cta
  }
  children = [Title, Sub, Cta]
}

component ConfirmBody <ModalContent>() layout {
  let Title: text = {
    content = title
  }
  let Sub: text = {
    content = subtitle
  }
  children = [Title, Sub]
}

component Modal(
  chromeTitle: String = "Dialog",
  slots: [ModalContent] = [UpsellBody()]
) layout {
  let Header: text = {
    content = chromeTitle
  }
  children = [Header, slots]
}
