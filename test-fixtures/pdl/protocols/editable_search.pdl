// EditableText host protocol demo — session value + facts + content mapping.
// Injected by EditableText: value (String), isEditing, isEmpty, isOverLimit.

protocol FormField: component {
  requires EditableText
  requires PointerInput
  placeholder: String = ""
  emits {
    change(value: String)
  }
}

component SearchField <FormField> (
  placeholder: String = "Search"
) text {
  content = placeholder
  fontSize = 15
  color = #111111

  if isEditing {
    content = value
    borderColor = #0066FF
    borderWidth = 1
  } else if isEmpty {
    content = placeholder
  } else {
    content = value
  }

  self.pressEnd = {
    if isEditing {
      // already editing — host owns the session
    } else {
      beginEditing(value)
    }
  }
  self.editingFinished = {
    finishEditing()
    emit change(value)
  }
  self.editingCancelled = {
    cancelEditing()
  }
}

component SearchBar(query: String = "") layout {
  direction = .row
  align = .center
  gap = 8
  padding = 12

  let Field = SearchField(value: query)
  children = [Field]

  Field.change(value: String) = {
    query = value
  }
}
