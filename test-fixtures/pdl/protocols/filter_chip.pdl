// B4–B5: emits + emit + ForEach layout `on` (FilterChip → LibrarySubnav).
// Pattern A: parent owns FilterId SoT; ForEach derives Bool `selected` per chip.

variant FilterId {
  case all
  case podcasts
  case episodes
  case hosts
}

variant ChipInteraction {
  case rest
  case hovered
  case click
}

protocol SubnavItem: component {
  requires PointerInput
  title = ""
  filter: FilterId = .all
  emits {
    select(filter: FilterId)
  }
}

component FilterChip <SubnavItem>(
  selected: Boolean = false,
  interactionState: ChipInteraction = .rest
) layout {
  direction = .row
  align = .center
  justify = .center
  gap = 6
  padding = EdgeInsets(x: 12, y: 8)
  cornerRadius = 999
  borderWidth = 1

  if selected {
    background = #222222
    borderColor = #222222
  } else if interactionState == .hovered {
    background = #FFFFFF
    borderColor = #222222
  } else if interactionState == .click {
    background = #444444
    borderColor = #222222 @ 0.0
  } else {
    background = #F2F2F4
    borderColor = #D0D0D5
  }

  let Label: text = {
    content = title
    fontSize = 13
    fontWeight = 600

    if selected {
      color = #FFFFFF
    } else {
      color = #111111
    }
  }

  children = [Label]

  self.hoverStart = {
    interactionState = .hovered
  }
  self.hoverEnd = {
    interactionState = .rest
  }
  self.pressStart = {
    interactionState = .click
  }
  self.pressEnd = {
    interactionState = .rest
    emit select(filter)
  }
}

component LibrarySubnav(
  currentFilter: FilterId = .all,
  chips: [SubnavItem] = [
    FilterChip(title: "All", filter: .all),
    FilterChip(title: "Podcasts", filter: .podcasts),
    FilterChip(title: "Episodes", filter: .episodes),
    FilterChip(title: "Hosts", filter: .hosts)
  ]
) layout {
  direction = .row
  align = .center
  gap = 8
  padding = EdgeInsets(x: 12, y: 12)

  ForEach(chips) { chip in
    chip.selected = self.currentFilter == filter

    chip.select(filter_id: FilterId) = {
      currentFilter = filter_id
    }
  }

  children = chips
}
