// PDL standard-library host protocols (language prelude).
//
// Canonical twin of docs/full-spec.md §4a′.
// Always in scope — no import required. Compilers inject these names into every
// design merge. Restating this file in a pack is documentation only; redefining
// a prelude name as an API protocol is PDL-E032.
//
// These are NOT child→parent `emits`. Host protocols declare:
//   • inbound channels  — environment → component  (`self.<channel> = { … }`)
//   • host verbs        — component → environment  (`beginEditing(…)` in handlers)
//   • well-known state  — injected into conforming components (see EditableText)
//
// Authors opt in with `component C <PointerInput>` or API `requires PointerInput`
// (PDL-E030 if a host channel/verb is used without effective conformance).

// ── Pointer / focus / lifecycle ─────────────────────────────────────

protocol PointerInput {
  host

  // Inbound — wire with `[self.]<name> = { … }` in the component kind body
  hoverStart
  hoverEnd
  pressStart
  pressEnd
  pressCancel
  focusStart
  focusEnd
  activate
  appear
  dismiss
}

// ── Editable text (pair with kind `text` — implies editable root) ───
//
// Well-known state (injected into components with effective EditableText —
// not protocol `params`, which host protocols may not declare — PDL-E032):
//   value: String = ""     — session String (peer name to Toggle/Slider value)
//   isEditing: Bool = false
//   isEmpty: Bool = true   — derived from value (idle / editing policy)
//   isOverLimit: Bool = false
//   contentLimit / contentLimitStyle — limits (host policy; see proposal)
//
// Authors map presentation separately: `content = self.value` (or a mask).
//
// Default activation (text-root): hosts begin editing on click/tap/focus of the
// leaf — no PointerInput / pressEnd required. Explicit beginEditing() remains
// for custom chrome. Not an implicit PointerInput conformance.
//
// activatesOn (injected; prelude variant TextFieldActivation):
//   .focus — default — click/tap/focus begins editing
//   .press — begin on press/click only (not bare focus)
//   .none  — program-only (beginEditing / isEditing); leaf hit-test does not begin
//
// Prefer session inbound below; `keyboardDismissed` / `keyboardCancelled` /
// `commitEditing` remain as migration aliases.

protocol EditableText {
  host

  // Inbound — session lifecycle
  editingBegan
  editingFinished
  editingCancelled

  // Migration aliases (same host delivery as finished / cancelled)
  keyboardDismissed
  keyboardCancelled

  // Host verbs
  beginEditing(startingValue)
  finishEditing()
  cancelEditing()

  // Migration alias for finishEditing
  commitEditing()
}

// ── Host environment (injected params come from the active `host` profile)
//
// No inbound channels. No verbs. Opt in with `component C <Host>`.
// The param names are pack-owned (`host Default(sizeClass: …)`), not listed here.
// Bake: defaults → mount(facts) → facts keys that match a param pin the bag.
// See shared/language-objects.json `host` / prelude `Host`.

protocol Host {
  host
}
