{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdl.dev/schema/component-catalogue.json",
  "title": "PDL componentCatalogue",
  "description": "Graph artefact. Token definitions may use primitive:/semantic: pointer strings. Empty maps may be omitted on CLI omitEmpty output.",
  "type": "object",
  "required": ["kind", "schemaVersion", "generatedAt", "components"],
  "properties": {
    "kind": { "const": "componentCatalogue" },
    "schemaVersion": { "type": "string", "const": "1.0.0-beta" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "theme": { "type": "string", "description": "Present only when catalogue was built with --theme." },
    "primitives": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/tokenRow" }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/tokenRow" }
    },
    "themes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/themeEntry" }
    },
    "catalogs": {
      "type": "object",
      "description": "Host-role remaps (`catalog`). Omitted when the design has none. Not listed in the user theme picker.",
      "additionalProperties": { "$ref": "#/$defs/catalogEntry" }
    },
    "hosts": {
      "type": "object",
      "description": "Host profiles (`host Name(params)`). Omitted when the design has none. Playground chrome lists variant params.",
      "additionalProperties": { "$ref": "#/$defs/hostProfileEntry" }
    },
    "typeStyles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/typeStyleEntry" }
    },
    "variantTypes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/variantTypeDef" }
    },
    "samples": {
      "type": "object",
      "description": "Optional. Bank → entry → field → evaluated value. Empty arrays preserved.",
      "additionalProperties": { "type": "object" }
    },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/catalogueComponentRow" }
    }
  },
  "$defs": {
    "tokenRow": {
      "type": "object",
      "required": ["name", "tokenType", "definition"],
      "properties": {
        "name": { "type": "string" },
        "tokenType": { "type": "string" },
        "definition": true
      }
    },
    "themeEntry": {
      "type": "object",
      "required": ["baseTheme", "overrides"],
      "properties": {
        "baseTheme": { "type": ["string", "null"] },
        "overrides": { "type": "object" }
      }
    },
    "catalogEntry": {
      "type": "object",
      "required": ["role", "overrides"],
      "properties": {
        "role": { "const": "host" },
        "overrides": { "type": "object" }
      }
    },
    "hostProfileEntry": {
      "type": "object",
      "required": ["params"],
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": {},
              "variantTypeName": { "type": "string" },
              "cases": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "typeStyleEntry": {
      "type": "object",
      "required": ["name", "props"],
      "properties": {
        "name": { "type": "string" },
        "props": { "type": "object" }
      }
    },
    "variantTypeDef": {
      "type": "object",
      "required": ["name", "cases"],
      "properties": {
        "name": { "type": "string" },
        "cases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "catalFrame": {
      "type": "object",
      "description": "Materialised frame in a default tree. Registry leaves (childNodes) omit nested children.",
      "required": ["id", "kind", "props"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "props": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalFrame" }
        },
        "instanceOf": { "type": "string" },
        "instanceKwargs": { "type": "object" }
      }
    },
    "registryFrame": {
      "type": "object",
      "description": "childNodes registry entry: no nested materialised children.",
      "required": ["id", "kind", "props"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "props": { "type": "object" },
        "children": {
          "type": "array",
          "maxItems": 0
        },
        "instanceOf": { "type": "string" },
        "instanceKwargs": { "type": "object" }
      }
    },
    "catalogueParam": {
      "type": "object",
      "required": ["name", "type", "default"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "default": true,
        "variantTypeName": { "type": "string" }
      },
      "additionalProperties": false
    },
    "variantChange": {
      "type": "object",
      "required": ["frameId", "prop", "value"],
      "properties": {
        "frameId": { "type": "string" },
        "prop": { "type": "string" },
        "value": true
      }
    },
    "catalogueVariantEntry": {
      "type": "object",
      "required": ["params", "affectedFrames"],
      "properties": {
        "params": { "type": "object" },
        "affectedFrames": { "type": "array", "items": { "type": "string" } },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/variantChange" }
        },
        "structuralChange": { "type": "boolean" },
        "childHierarchy": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "rootFrame": {
      "type": "object",
      "required": ["kind", "props"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "props": { "type": "object" }
      }
    },
    "catalogueEmit": {
      "type": "object",
      "required": ["name", "args"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "args": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        },
        "propagation": {
          "type": "string",
          "enum": ["parent", "ancestors"],
          "description": "How far an unhandled emit travels. Omitted when `.parent` (default)."
        }
      }
    },
    "catalogueEmitCapture": {
      "type": "object",
      "required": ["channel", "payload", "body"],
      "additionalProperties": false,
      "properties": {
        "qualifier": {
          "type": "string",
          "description": "Child let or ForEach list name. Omitted for ancestor capture."
        },
        "channel": { "type": "string" },
        "payload": { "type": "array" },
        "body": { "type": "array" },
        "capture": {
          "const": "ancestor",
          "description": "Present when this is a bare `channel(…) =` ancestor capture."
        }
      }
    },
    "catalogueComponentRow": {
      "type": "object",
      "required": ["name", "root"],
      "properties": {
        "name": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["component", "page", "screen"],
          "description": "Declaration keyword. Omitted when `component` (default)."
        },
        "conformsTo": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Receive protocols from `component C <P, Q>` (host inbound + ancestor sinks). Omitted when empty."
        },
        "emitsProtocols": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Send protocols from `emits <P>` (channels, API params, `[P]` slot membership). Omitted when empty."
        },
        "hostProtocols": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Effective host protocols (header names plus API `requires`)."
        },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogueParam" }
        },
        "expose": { "type": "array", "items": { "type": "string" } },
        "usage": { "type": "string" },
        "usageByKey": { "type": "object" },
        "fixtures": { "type": "object" },
        "rules": { "type": "object" },
        "interactions": { "type": "array" },
        "emits": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogueEmit" },
          "description": "Effective emit channels. `propagation` is omitted when `.parent` (default)."
        },
        "emitCaptures": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogueEmitCapture" },
          "description": "Layout emit captures. Ancestor captures omit `qualifier` and set `capture` to `ancestor`."
        },
        "root": { "$ref": "#/$defs/rootFrame" },
        "defaultParams": { "type": "object" },
        "childNodes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/registryFrame" }
        },
        "childHierarchy": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "requiredComponents": { "type": "array", "items": { "type": "string" } },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogueVariantEntry" }
        }
      },
      "additionalProperties": false
    }
  }
}
