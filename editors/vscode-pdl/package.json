{
  "name": "pdl",
  "displayName": "PDL",
  "description": "Syntax highlighting for Programmatic Design Language (.pdl)",
  "version": "0.1.0",
  "publisher": "veritinymachines",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
